# Backend
APP_NAME="Meitai AI Business Innovation Agent API"
APP_ENV="development"
FRONTEND_ORIGIN="http://localhost:3001"
DATABASE_URL="sqlite:///./backend/data/meitai_demo.db"

# Frontend
NEXT_PUBLIC_API_BASE_URL=""
# Server-side rewrite target. Docker uses http://backend:8000 at build time.
API_PROXY_TARGET="http://127.0.0.1:8000"

# Development generates backend/data/.jwt-secret when empty.
# Production requires a newly generated random secret of at least 32 characters.
JWT_SECRET_KEY=""
LLM_MODE="mock"
LLM_REPORT_ENABLED="false"
PAYMENT_PROVIDER_MODE="mock"

# Password reset email (disabled by default)
SMTP_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Meitai AI"
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
PASSWORD_RESET_URL="http://localhost:3001/reset-password"

# LLM credentials -> backend/app/core/mykey.py (gitignored)
# Copy mykey.py.example and fill in real keys if you need live mode.

# RAG (disabled by default)
RAG_ENABLED="false"
CHROMA_PERSIST_DIR="./backend/data/chroma"
RAG_TOP_K="5"

# Lite public research: real public HTTP, independent of RAG and LLM mode.
# bing uses public RSS with DuckDuckGo fallback and needs no API key.
# Set brave plus a key to use Brave Search; never commit a real key.
LITE_SEARCH_PROVIDER="bing"
BRAVE_SEARCH_API_KEY=""

# Intake Import
INTAKE_MAX_UPLOAD_SIZE_MB="10"
INTAKE_PDF_OCR_ENABLED="true"
INTAKE_PDF_OCR_MIN_TEXT_CHARS="20"
INTAKE_PDF_OCR_MAX_PAGES="12"
